#!/bin/bash
# postinst — runs after the package files are unpacked.
#
# Responsibilities:
#   1. Create an isolated Python virtual environment for LocalDiscord.
#   2. Install all required Python dependencies into that venv.
#   3. Refresh desktop/icon caches so the app appears in the menu.
#
# The venv lives at /usr/lib/localdiscord/venv and is fully self-contained,
# so it never interferes with system Python packages.

set -e

INSTALL_DIR="/usr/lib/localdiscord"
VENV_DIR="$INSTALL_DIR/venv"

case "$1" in
    configure)
        echo "==> Configuring LocalDiscord..."

        # --- Sanity check ---
        if ! command -v python3 &>/dev/null; then
            echo "ERROR: python3 not found. Please install python3 >= 3.10." >&2
            exit 1
        fi

        PY_VER=$(python3 -c "import sys; print(f'{sys.version_info.major}.{sys.version_info.minor}')")
        PY_MAJOR=$(python3 -c "import sys; print(sys.version_info.major)")
        PY_MINOR=$(python3 -c "import sys; print(sys.version_info.minor)")

        if [ "$PY_MAJOR" -lt 3 ] || { [ "$PY_MAJOR" -eq 3 ] && [ "$PY_MINOR" -lt 10 ]; }; then
            echo "ERROR: Python 3.10 or newer is required (found $PY_VER)." >&2
            exit 1
        fi

        echo "    Python $PY_VER found."

        # --- Create virtual environment ---
        echo "==> Creating Python virtual environment at $VENV_DIR ..."
        python3 -m venv --system-site-packages "$VENV_DIR"

        # --- Upgrade pip inside the venv ---
        echo "==> Upgrading pip..."
        "$VENV_DIR/bin/pip" install --quiet --upgrade pip

        # --- Install Python dependencies ---
        echo "==> Installing Python dependencies (PyQt6, cryptography, zeroconf, psutil)..."
        echo "    This may take a minute on the first install..."

        "$VENV_DIR/bin/pip" install --quiet \
            "PyQt6>=6.4.0" \
            "cryptography>=41.0.0" \
            "zeroconf>=0.131.0" \
            "psutil>=5.9.0"

        echo "==> Python dependencies installed."

        # --- Fix ownership: everything should be owned by root ---
        chown -R root:root "$INSTALL_DIR"

        # --- Update the icon cache ---
        if command -v gtk-update-icon-cache &>/dev/null; then
            gtk-update-icon-cache -f -t /usr/share/icons/hicolor 2>/dev/null || true
        fi

        # --- Update the desktop database ---
        if command -v update-desktop-database &>/dev/null; then
            update-desktop-database /usr/share/applications 2>/dev/null || true
        fi

        echo ""
        echo "  LocalDiscord installed successfully!"
        echo "  Run it from your application menu, or type: localdiscord"
        echo ""
        ;;

    abort-upgrade|abort-remove|abort-deconfigure)
        ;;

    *)
        echo "postinst called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

exit 0
