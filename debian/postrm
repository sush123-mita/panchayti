#!/bin/bash
# postrm — runs after the package files are removed.
#
# On purge: remove any remaining installation directory.
# Note: user config (~/.localdiscord) is intentionally left behind
#       to preserve chat history and preferences.

set -e

case "$1" in
    purge)
        echo "==> Purging LocalDiscord installation files..."
        rm -rf /usr/lib/localdiscord

        # Update icon cache
        if command -v gtk-update-icon-cache &>/dev/null; then
            gtk-update-icon-cache -f -t /usr/share/icons/hicolor 2>/dev/null || true
        fi

        # Update desktop database
        if command -v update-desktop-database &>/dev/null; then
            update-desktop-database /usr/share/applications 2>/dev/null || true
        fi
        ;;

    remove|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        # Update desktop database after file removal
        if command -v update-desktop-database &>/dev/null; then
            update-desktop-database /usr/share/applications 2>/dev/null || true
        fi
        ;;

    *)
        echo "postrm called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

exit 0
